# Скопируйте в .env и при необходимости измените значения: cp .env.example .env
# Файл .env не коммитится (см. .gitignore).

# Персональный токен GitHub (необязателен). Оставьте пустым, если токена нет.
RG_GITHUB_TOKEN=
# Каталог для данных проекта.
RG_DATA_DIR=data
# Уровень логирования: DEBUG | INFO | WARNING | ERROR | CRITICAL
RG_LOG_LEVEL=INFO
# Формат логов: text | json
RG_LOG_FORMAT=text
# Таймаут HTTP-запросов, секунды: (0; 300]
RG_REQUEST_TIMEOUT=10
# Максимум параллельных запросов: [1; 64]
RG_MAX_CONCURRENCY=4
